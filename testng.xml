<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="All Test Suite" parallel="methods" thread-count="1">
    <listeners>
        <listener class-name="listeners.ListenersClass"/>
       <!-- <listener class-name="listeners.AnnotationTransformer"/>-->
    </listeners>
    <test name="RegisterTests">
        <classes>
            <class name="LawyerTestcase.RegisterTestCase"/>
        </classes>
    </test>

    <test name="LawyerUIAutomation">
        <classes>
            <class name="LawyerTestcase.LoginTestCase"/>
            <class name="LawyerTestcase.SlotBookingTestCase"/>
            <class name="LawyerTestcase.DayWiseSlotBookingTestCase"/>
        </classes>
    </test>
</suite>
